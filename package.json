{
  "name": "moneyquest",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "e2e": "playwright test",
    "import:questions": "node tools/import-questions.ts",
    "import:assets": "node tools/import-assets.ts",
    "dev:all": "concurrently -k -n server,game -c blue,green \"npm --prefix server run dev -- --var PEPPER:dev-pepper --var ADMIN_EMAIL:admin@moneyquest.test\" \"VITE_MP_URL=http://localhost:8787 vite\"",
    "server:typecheck": "npm --prefix server run typecheck",
    "server:test": "npm --prefix server test"
  },
  "dependencies": {
    "jsqr": "1.4.0",
    "phaser": "4.2.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@fontsource/fredoka": "5.3.0",
    "@playwright/test": "1.65.0",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "concurrently": "10.0.6",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
